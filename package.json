{
  "name": "cre-agent-studio",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w api",
    "start": "npm run start -w api",
    "build": "npm run build -w api && npm run build -w web",
    "test": "npm test -w api && npm test -w web",
    "migrate": "npm run migrate -w api",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "dev:web": "npm run dev -w web",
    "seed:demo": "npm run seed:demo -w api",
    "seed:mri": "npm run seed:mri -w api --",
    "seed:acr": "npm run seed:acr -w api --",
    "ai:check": "npm run ai:check -w api",
    "set-role": "npm run set-role -w api --",
    "set-role": "npm run set-role -w api --"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
