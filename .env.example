# Copy to .env (never commit .env)
PORT=4000
LOG_LEVEL=info

# Azure SQL (XCreAgents)
DB_SERVER=cresqlserver.database.windows.net
DB_NAME=XCreAgents
DB_USER=
DB_PASSWORD=

# CRE sign-in (Entra External ID / CIAM) - same tenant and API as CRE web
CRE_TENANT_ID=8b95a7b3-effb-4d96-a5c2-118fe047e71a
CRE_API_CLIENT_ID=790433ef-9282-4ca5-91df-bbb9369bb43e
CRE_REQUIRED_SCOPE=access_as_user

# Optional, development only: tenant id that first-time users are added to.
# Leave empty in production (users must be added by a Studio admin).
AUTO_PROVISION_TENANT_ID=

# AI steps (Azure AI Foundry, OpenAI v1). Leave AI_API_KEY empty to run
# without AI (AI steps are then shown as "not set up").
AI_ENDPOINT=https://cre-openai-service-resource.services.ai.azure.com/openai/v1
AI_API_KEY=
AI_DEPLOYMENT=CREAgentStudio__gpt-6.1-sol
AI_TIMEOUT_MS=20000
